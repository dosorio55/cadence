{
  "name": "cadence-electron",
  "version": "1.0.0",
  "description": "Cadence \u2014 offline piano practice studio",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run chords:check && npm run build && electron-builder --dir",
    "build:win": "npm run chords:check -- win32 && npm run build && electron-builder --win",
    "build:mac": "npm run chords:check -- darwin && electron-vite build && electron-builder --mac",
    "build:linux": "npm run chords:check -- linux && electron-vite build && electron-builder --linux",
    "chords:build": "node scripts/chord-worker.mjs build",
    "chords:check": "node scripts/chord-worker.mjs check",
    "db:generate": "node scripts/drizzle.mjs generate",
    "db:migrate": "node scripts/drizzle.mjs migrate",
    "db:studio": "node scripts/drizzle.mjs studio",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.23.0",
    "better-sqlite3": "^12.0.0",
    "react-router-dom": "^7.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/geist-sans": "^5.0.0",
    "@fontsource/geist-mono": "^5.0.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.31.11",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
